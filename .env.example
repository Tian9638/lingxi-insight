# ============================================
# 灵犀洞察 · 环境变量示例
# 复制为 .env.local 并按需填写（.env.local 已被 .gitignore 忽略）
# ============================================

# ---- 接入真实大模型（OpenAI 兼容协议）----
# 填写后 AI 引擎自动从「本地演示引擎」切换为「真实模型通道」：
#   · LLM 通过 Function Calling 调用与本地引擎完全相同的工具集
#   · 工具在服务端真实执行，结果回注 LLM 继续推理
#   · 通道异常时自动回退本地引擎，演示不中断
# 不填写则使用内置本地演示引擎，全部功能可完整体验。

# ① API Key（必填）
OPENAI_API_KEY=

# ② 接口地址（必填，各厂商见 docs/模型接入指南.md）
#    OpenAI        https://api.openai.com/v1
#    DeepSeek      https://api.deepseek.com/v1
#    智谱 GLM      https://open.bigmodel.cn/api/paas/v4
#    通义千问      https://dashscope.aliyuncs.com/compatible-mode/v1
#    Kimi          https://api.moonshot.cn/v1
#    OpenRouter    https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# ③ 模型名称（必填，需支持 Function Calling / Tools）
#    gpt-4o-mini / deepseek-chat / glm-4-plus / qwen-plus / moonshot-v1-8k ...
OPENAI_MODEL=gpt-4o-mini

# ---- 可选：应用访问端口 ----
# PORT=3000
